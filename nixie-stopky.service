[Unit]
Description=Nixie Stopky Time Tracker
After=network.target

[Service]
Type=simple
User=nixie
Group=nixie
WorkingDirectory=/opt/nixie-stopky/backend
ExecStart=/opt/nixie-stopky/venv/bin/gunicorn \
    --workers 2 \
    --bind 0.0.0.0:5000 \
    --timeout 60 \
    --access-logfile /var/log/nixie-stopky/access.log \
    --error-logfile /var/log/nixie-stopky/error.log \
    "app:create_app()"
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
